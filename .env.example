# Copy this file to `.env` and adjust the values.
# Real environment variables always take precedence over this file.
# `.env` is gitignored — never commit actual credentials.

# Database — shared by docker-compose (db service) and Django settings.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Use `localhost` when Django runs on the host machine;
# use `db` (the compose service name) when Django runs in a container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
