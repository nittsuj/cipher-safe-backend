# Copy this file to `.env` and adjust the values.
# Real environment variables always take precedence over this file.
# `.env` is gitignored — never commit actual credentials.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — shared by docker-compose (db service) and Django settings.
POSTGRES_DB=cipher_safe
POSTGRES_USER=cipher_safe
POSTGRES_PASSWORD=change-me

# Used when Django runs on your machine (`uv run python manage.py runserver`).
# `docker compose up` overrides these for the api container (host `db`, port 5432).
# POSTGRES_PORT is also the port the database is published on; change it if
# 5432 is already taken.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Port the API is published on by `docker compose up` (default 8000).
# API_PORT=8000

# Frontend origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest file accepted by the upload endpoint, in bytes (default 128 MiB).
MAX_UPLOAD_BYTES=134217728

# DRF throttle rates. Optional; shown with their defaults.
# THROTTLE_AUTH=10/min
# THROTTLE_BENCHMARK=10/min
# THROTTLE_KEYGEN=10/min
# THROTTLE_ANON=20/min
# THROTTLE_USER=240/min

# JWT lifetimes. Optional; shown with their defaults.
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=1
